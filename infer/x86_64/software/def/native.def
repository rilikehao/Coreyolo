package = platform.native
headers = native.h
compilerOpts = --sysroot=/usr/aarch64-linux-gnu -I../../../x86_64/root/usr/include -I../../../x86_64/root/usr/local/include -I../../../x86_64/root/usr/local/software/include
linkerOpts = -Lx86_64/root/usr/lib -Lx86_64/root/usr/local/lib -Lx86_64/root/usr/local/software/lib -lNative
noStringConversion = HttpGet HttpPost DrawRect SendData
