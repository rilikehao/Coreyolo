package = platform.ffmpeg
headers = libavformat/avformat.h libavcodec/avcodec.h libavutil/avutil.h libswscale/swscale.h libavutil/imgutils.h libavutil/hwcontext.h
compilerOpts = --sysroot=/usr/aarch64-linux-gnu -I../../../aarch64/root/usr/include -I../../../aarch64/root/usr/local/include
linkerOpts = -Laarch64/root/usr/lib -Laarch64/root/usr/local/lib -lavformat -lavcodec -lavutil -lswscale -lavfilter
