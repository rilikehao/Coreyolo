package = platform.native
headers = native.h
compilerOpts = --sysroot=/usr/aarch64-linux-gnu -I../../../aarch64/root/usr/include -I../../../aarch64/root/usr/local/include -I../../../aarch64/root/usr/local/ascend-8.0.0/include
linkerOpts = -Laarch64/root/usr/lib -Laarch64/root/usr/local/lib -Laarch64/root/usr/local/ascend-8.0.0/lib -lNative
noStringConversion = HttpGet HttpPost DrawRect SendData
